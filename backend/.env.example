# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection string in .env
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/career_explorer?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster.mongodb.net/career_explorer?retryWrites=true&w=majority

# JWT Secret Key for Authentication Tokens
# Replace with a strong secret key in .env
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=30d
